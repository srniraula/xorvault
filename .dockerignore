# .dockerignore - Files to exclude from Docker build context
# This speeds up builds and reduces image size

# Binaries (we build fresh in Docker)
bin/
*.exe
*.dll
*.so
*.dylib

# Test files
*_test.go
*.test

# Data directories (created at runtime)
chunk_server1/
chunk_server2/
chunk_server3/
chunks/
data/

# Log files directory
log_files/
*.log

# Test files directory (don't copy PDFs to Docker image)
files/

# Checkpoint and WAL files (created at runtime)
*.checkpoint
*.wal

# Downloaded files (test artifacts)
downloaded_*

# Client ID file (created at runtime)
.client_id

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
README.md
*.md

# Docker files themselves (no need to copy into image)
Dockerfile
docker-compose.yml
.dockerignore
