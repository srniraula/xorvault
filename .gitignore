# --- Binaries and Build Artifacts ---
# Ignore compiled executables (from both local builds and inside /bin directory)
*.exe
*.out
/master
/chunkserver
/client
# Ignore any Go cache or temporary files
/pkg/
/tmp/

# --- Docker Files (DO NOT COMMIT) ---
# Environment variables used for local setup
.env
# Named volumes (if you switch to them)
volumes/
# Common archive files often used for distribution, not source
*.zip
*.tar

# --- Persistent Data and Storage Directories (CRITICAL) ---
# These are the host directories bound to the /data mount point in Docker Compose:
# Master data directory
master-data/
# Chunkserver data directories
chunkserver1-data/
chunkserver2-data/
chunkserver3-data/

# Old/Legacy storage directories from internal testing/code:
chunk_server1/
chunk_server2/
chunk_server3/
chunks/
chunks1/
chunks2/
chunks3/

# --- Log, State, and Temporary Files ---
# Log directories and files
log_files/*
*.log
!log_files/README.md  # Keep the README file inside the log directory

# Write-Ahead Logs and Checkpoints (used for system recovery/state)
*.wal
*.wal.old
*.checkpoint

# Client-side temporary/state files
.client_id
.client_id.*
downloaded_*

# Test files and workspaces
files/*
!files/README.md       # Keep the README inside the files directory
clients/

# --- IDE and OS Files ---
# Integrated Development Environment configuration files
.vscode/
.idea/
*.swp
*.swo
*~

# --- Local Configuration and Credentials (SECURITY) ---
.master_addr
.secondary_master_addr
data/users.json       # User credentials and passwords
dfs_metrics.csv       # Local metrics data

# --- Personal/Development Notes ---
personal/             # Internal notes and development documentation

# Operating System temporary files
.DS_Store
Thumbs.db

# Allow the dfsclient package under pkg/ to be tracked (pkg/ is ignored by default)
!/pkg/
!/pkg/dfsclient/
!/pkg/dfsclient/**


personal/
web/node_modules/
web/node_modules/.vite/

data/